# Base de datos propia de bookings-service (Neon/Postgres). Sin definirla se usa SQLite local.
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require
# Contratos REST que consume bookings-service. Sin definirlas se usa el modo desarrollo.
USERS_SERVICE_URL=http://localhost:8001
RESOURCES_SERVICE_URL=http://localhost:8002
HTTP_TIMEOUT_SECONDS=3
# Tarifa por hora que asume el modo desarrollo cuando resources-service no está configurado
DEV_DEFAULT_HOURLY_RATE=0
